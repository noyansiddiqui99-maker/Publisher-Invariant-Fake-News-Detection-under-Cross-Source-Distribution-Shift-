3	982393078949535744	982394505050521600	982401702782488576	982405561684779009	982407653149290496	982410185649082368	982412167747170304	982415552495878144	982416069397643265	982418204373999616	982420715889741824	982427010478886913	982427516592885762	982430204491714560	982433927284523008	982436913373220864	982442455860686850	982444479838900224	982444992483344384	982449336310255616	982453380399411201	982454933168390146	982455942229852161	982457806887374848	982458385147686912	982458387182047233	982459702305894401	982462333422264320	982464743527993344	982474340930326529	982477402277232645	982478142702014464	982478573415030784	982487952340074497	982489017764560896	982507669796859904	982514161488941057	982526893571194880	982539781988024320	982541054221135872	982543357435138048	982549370326388737	982561770677121024	982573210620317696	982581748029644800	982584802246262785	982591571995471872	982594917296828416	982601658596081664	982602141150863360	982603905971441664	982604108430495744	982605227424735234	982608362775851010	982608361932795904	982608368412999683	982608367540514817	982608987412721667	982609285765976064	982609285099278336	982609738981691392	982610229958447104	982610479746076672	982610503347441665	982610758432276480	982611217616375811	982611294040846336	982616588871282689	982617675997249536	982618030621515776	982620235097243648	982635300953427968	982641631261323264	982653458703466497	982660275366256640	982669840107237376	982669847636201473	982680417256931328	982695460241592320	982697521888686080	982707617868013568	982710051424043009	982716599416139776	982724867723350017	982724947725266944	982739548793794563	982759896117424129	982767215689678849	982786512000507904	982796883583258624	982810063260839938	982819282043023361	982823228228952064	982840707185508352	982856609914343424	982857709832716288	982863941096345601	982868412903768065	982915958493790208	982937593716199424	983103744509280256	983294876027686912	983547020127473664	983719918657916928	983779444627247105	984036902125711360	984238690565177346	986058554338627584	987566415862423557	987861054683262976	993200341188423680	1003575801743335425	1057343961734438912,0,etonline.com,83,"Brooke Burke filed for divorce from husband David Charvet after six years of marriage on Friday, citing irreconcilable differences, ET can confirm.
